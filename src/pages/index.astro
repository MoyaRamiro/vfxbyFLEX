---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Destacados from '../components/Destacados.astro';
import Configurador from '../components/Configurador.astro';
import CartDrawer from '../components/CartDrawer.astro';
import Marquee from '../components/Marquee.astro';
import Footer from '../components/Footer.astro';
---

<Base
  title="VFXBYFLEX - Servicios de VFX, Visualizers y Montaje"
  description="Cotizá tu VFX, visualizer o montaje con Flex. Configurá tu pedido y envialo directo por WhatsApp."
>
  <main>
    <Hero />
    <Destacados />
    <Marquee />
    <Configurador />
  </main>
  <Footer />
  <CartDrawer />
</Base>

<script>
  import { initConfigurator } from '../lib/configurator-ui';
  initConfigurator();
</script>

<script>
  import { initDrawer } from '../lib/drawer-ui';
  initDrawer();
</script>
