---
import { getLangFromUrl, useTranslations, getLocalizedPath } from '../i18n/utils';
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const REVIEWS_URL = 'https://www.instagram.com/stories/highlights/18103255340029730/';
const otherLang = lang === 'es' ? 'en' : 'es';
const switchHref = getLocalizedPath(otherLang, '/');
---

<header class="px-6 md:px-10 py-10 bg-paper border-b-2 border-ink">
  <div class="max-w-6xl mx-auto flex flex-col gap-10">
    <nav class="flex items-center justify-between gap-3">
      <a href={switchHref} class="border-2 border-ink px-3 py-1.5 font-mono text-xs font-bold hover:bg-ink hover:text-paper transition-colors uppercase">{otherLang}</a>
      <div class="flex items-center gap-2 sm:gap-3">
        <a href="#servicios" class="hidden md:inline-block border-2 border-ink px-4 py-2 font-bold hover:bg-ink hover:text-paper transition-colors">{t('navArmar')}</a>
        <a id="wa-cta" href="#" class="border-2 border-ink bg-lime px-3 sm:px-4 py-2 font-bold hover:bg-ink hover:text-paper transition-colors">WhatsApp</a>
        <button type="button" class="cart-trigger hidden sm:inline-block border-2 border-ink px-3 sm:px-4 py-2 font-bold hover:bg-ink hover:text-paper transition-colors">
          {t('navCart')} <span data-cart-count class="font-mono">0</span>
        </button>
      </div>
    </nav>

    <div class="flex flex-col lg:flex-row items-start lg:items-end justify-between gap-10">
      <div class="max-w-2xl">
        <h1 aria-label="VFXbyFlex" class="flex flex-col items-start gap-4">
          <span aria-hidden="true" class="bg-ink px-2.5 py-1 font-mono text-[11px] font-bold tracking-[0.45em] text-lime">VFX</span>
          <span aria-hidden="true" class="text-4xl sm:text-6xl md:text-8xl font-black leading-[0.85] tracking-tighter text-ink">
            VFX<span class="mx-1 inline-block bg-lime px-1.5 pb-0.5">by</span>Flex
          </span>
        </h1>
        <div class="mt-6 flex flex-wrap gap-3">
          <a href="#servicios" class="border-2 border-ink px-5 py-3 font-bold bg-ink text-paper hover:bg-paper hover:text-ink transition-colors">{t('startNow')}</a>
          <a href="https://www.instagram.com/vfxbyflex/" target="_blank" rel="noopener noreferrer" class="border-2 border-ink px-5 py-3 font-bold hover:bg-ink hover:text-paper transition-colors">{t('seeWorks')}</a>
        </div>
      </div>
      <a
        href={REVIEWS_URL}
        target="_blank"
        rel="noopener noreferrer"
        class="w-full lg:w-80 flex flex-col gap-2 border-2 border-ink p-4 hover:bg-lime/10 transition-colors"
      >
        <span class="flex items-center gap-1 text-lime" aria-label={t('ratingAria')}>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2l2.9 6.3 6.9.8-5.1 4.7 1.4 6.8L12 17.3 5.9 20.6l1.4-6.8L2.2 9.1l6.9-.8L12 2z"/></svg>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2l2.9 6.3 6.9.8-5.1 4.7 1.4 6.8L12 17.3 5.9 20.6l1.4-6.8L2.2 9.1l6.9-.8L12 2z"/></svg>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2l2.9 6.3 6.9.8-5.1 4.7 1.4 6.8L12 17.3 5.9 20.6l1.4-6.8L2.2 9.1l6.9-.8L12 2z"/></svg>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2l2.9 6.3 6.9.8-5.1 4.7 1.4 6.8L12 17.3 5.9 20.6l1.4-6.8L2.2 9.1l6.9-.8L12 2z"/></svg>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2l2.9 6.3 6.9.8-5.1 4.7 1.4 6.8L12 17.3 5.9 20.6l1.4-6.8L2.2 9.1l6.9-.8L12 2z"/></svg>
        </span>
        <p class="mt-1 font-bold">{t('reviews')}</p>
        <p class="text-xs text-muted">{t('reviewsSub')}</p>
      </a>
    </div>
  </div>
</header>