---
import { SITE } from '../config/site';

const TITLE = 'VFX';
const SLOGAN = 'Animaciones y efectos que le dan movimiento a tus ideas.';
const REVIEWS_URL = `${SITE.instagramUrl}highlights/`;
---

<header class="px-6 md:px-10 py-10 bg-paper border-b-2 border-ink">
  <div class="max-w-6xl mx-auto flex flex-col gap-10">
    <nav class="flex items-center justify-between gap-3">
      <a href="/" class="flex flex-col shrink-0">
        <span class="text-xs font-mono tracking-widest text-muted">VFX</span>
        <span class="text-2xl md:text-3xl font-bold leading-tight">VFXbyFlex</span>
      </a>
      <div class="flex items-center gap-2 sm:gap-3">
        <a href="#servicios" class="hidden md:inline-block border-2 border-ink px-4 py-2 font-bold hover:bg-ink hover:text-paper transition-colors">Armar pedido</a>
        <a id="wa-cta" href="#" class="border-2 border-ink bg-lime px-3 sm:px-4 py-2 font-bold hover:bg-ink hover:text-paper transition-colors">WhatsApp</a>
        <button type="button" class="cart-trigger hidden sm:inline-block border-2 border-ink px-3 sm:px-4 py-2 font-bold hover:bg-ink hover:text-paper transition-colors">
          Carrito <span data-cart-count class="font-mono">0</span>
        </button>
      </div>
    </nav>

    <div class="flex flex-col lg:flex-row items-start lg:items-end justify-between gap-10">
      <div class="max-w-2xl">
        <span class="block text-xs font-mono tracking-widest text-muted mb-3">VFX</span>
        <h1 class="text-4xl sm:text-5xl md:text-7xl font-bold leading-[0.98] tracking-tight">{SLOGAN}</h1>
        <p class="mt-5 text-lg text-muted max-w-xl">
          Configurador profesional para videos cortos, lyric visuals, croma y VFX. Elegí duración, mood y complementos. Total en USD y envío directo por WhatsApp.
        </p>
        <div class="mt-6 flex flex-wrap gap-3">
          <a href="#servicios" class="border-2 border-ink px-5 py-3 font-bold bg-ink text-paper hover:bg-paper hover:text-ink transition-colors">Empezar ahora</a>
          <a href="#trabajos" class="border-2 border-ink px-5 py-3 font-bold hover:bg-ink hover:text-paper transition-colors">Ver trabajos</a>
        </div>
      </div>
      <a
        href={REVIEWS_URL}
        target="_blank"
        rel="noopener noreferrer"
        class="w-full lg:w-80 flex flex-col gap-2 border-2 border-ink p-4 hover:bg-lime/10 transition-colors"
      >
        <span class="flex items-center gap-1 text-lime" aria-label="5 de 5 estrellas">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2l2.9 6.3 6.9.8-5.1 4.7 1.4 6.8L12 17.3 5.9 20.6l1.4-6.8L2.2 9.1l6.9-.8L12 2z"/></svg>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2l2.9 6.3 6.9.8-5.1 4.7 1.4 6.8L12 17.3 5.9 20.6l1.4-6.8L2.2 9.1l6.9-.8L12 2z"/></svg>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2l2.9 6.3 6.9.8-5.1 4.7 1.4 6.8L12 17.3 5.9 20.6l1.4-6.8L2.2 9.1l6.9-.8L12 2z"/></svg>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2l2.9 6.3 6.9.8-5.1 4.7 1.4 6.8L12 17.3 5.9 20.6l1.4-6.8L2.2 9.1l6.9-.8L12 2z"/></svg>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2l2.9 6.3 6.9.8-5.1 4.7 1.4 6.8L12 17.3 5.9 20.6l1.4-6.8L2.2 9.1l6.9-.8L12 2z"/></svg>
        </span>
        <p class="mt-1 font-bold">Recomendado por muchos artistas</p>
        <p class="text-xs text-muted">Mirá las reseñas en historias destacadas de Instagram.</p>
      </a>
    </div>
  </div>
</header>