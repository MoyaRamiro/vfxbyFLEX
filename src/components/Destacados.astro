---
import { Picture } from 'astro:assets';
import { PROJECTS } from '../data/projects';
import { SITE } from '../config/site';
---

<section id="destacados" class="px-6 md:px-10 py-24 md:py-32">
  <div class="max-w-6xl mx-auto">
    <div class="flex items-end justify-between mb-6">
      <h2 class="destacados-title text-4xl md:text-6xl font-bold">Destacados</h2>
      <span class="hidden md:block font-mono text-sm text-muted">EN PRODUCCIÓN · 2026</span>
    </div>

    <p class="text-muted max-w-xl mb-12">
      Estoy armando el showreel nuevo. Mientras tanto, cada trabajo sale primero por Instagram —
      <a href={PROJECTS[0].url} target="_blank" rel="noopener noreferrer" class="text-ink font-medium underline-offset-4 hover:underline hover:decoration-cyan hover:decoration-2 transition-colors">@{SITE.instagram}</a>.
    </p>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
      {PROJECTS.map((p, i) => (
        <a
          href={p.url}
          target="_blank"
          rel="noopener noreferrer"
          class="project-card group relative block overflow-hidden border-2 border-ink bg-surface aspect-video magnetic"
        >
          <div class="project-thumb absolute inset-0 overflow-hidden">
            <Picture
              src={p.thumbnail}
              alt={`Próximamente: muestra de ${p.title} de VFXBYFLEX`}
              formats={['avif', 'webp']}
              widths={[640, 960, 1280]}
              sizes="(min-width: 640px) 50vw, 100vw"
              loading="lazy"
              decoding="async"
              class="h-full w-full object-cover scale-110 transition-transform duration-500 group-hover:scale-[1.18]"
            />
          </div>
          <div class="project-glitch absolute inset-0 opacity-0 bg-cyan mix-blend-multiply transition-opacity duration-100 group-hover:opacity-30"></div>
          <div class="absolute inset-x-0 bottom-0 flex items-center justify-between p-4 bg-paper/90 backdrop-blur-sm border-t-2 border-ink">
            <span class="font-bold">{p.title}</span>
            <span class="font-mono text-xs text-muted">PRÓXIMAMENTE</span>
          </div>
          <span class="absolute top-3 right-3 bg-lime text-ink text-xs font-bold px-2 py-1 opacity-0 group-hover:opacity-100 transition-opacity">VER EN IG ↗</span>
        </a>
      ))}
    </div>
  </div>
</section>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  const mm = gsap.matchMedia();
  mm.add('(prefers-reduced-motion: no-preference)', () => {
    gsap.from('.destacados-title', {
      opacity: 0,
      y: 40,
      scrollTrigger: { trigger: '#destacados', start: 'top 75%' },
      duration: 0.7,
      ease: 'power3.out',
    });

    gsap.from('.project-card', {
      opacity: 0,
      y: 60,
      stagger: 0.12,
      duration: 0.7,
      ease: 'power3.out',
      scrollTrigger: { trigger: '#destacados', start: 'top 70%' },
    });

    document.querySelectorAll<HTMLElement>('.project-thumb img').forEach((img) => {
      gsap.fromTo(img, { yPercent: -6 }, {
        yPercent: 6,
        ease: 'none',
        scrollTrigger: { trigger: img, scrub: true },
      });
    });

    document.querySelectorAll<HTMLElement>('.magnetic').forEach((el) => {
      el.addEventListener('mousemove', (e) => {
        const rect = el.getBoundingClientRect();
        const x = e.clientX - rect.left - rect.width / 2;
        const y = e.clientY - rect.top - rect.height / 2;
        gsap.to(el, { x: x * 0.03, y: y * 0.03, duration: 0.3, ease: 'power2.out' });
      });
      el.addEventListener('mouseleave', () => {
        gsap.to(el, { x: 0, y: 0, duration: 0.5, ease: 'elastic.out(1, 0.4)' });
      });
    });
  });
</script>
