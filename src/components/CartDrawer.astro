---
import { SITE } from '../config/site';
import { AUDIO_NOTE, SENA, WHATSAPP_MODES } from '../config/order';
import { getLangFromUrl, useTranslations } from '../i18n/utils';
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const SENA_PCT = Math.round((SENA.rate ?? 0) * 100);

const modes = Object.values(WHATSAPP_MODES).map((m) => ({
  id: m.id,
  label: lang === 'en' ? (m.id === 'chat' ? t('modeChatLabel') : t('modeReceiptLabel')) : m.label,
  intro: lang === 'en' ? (m.id === 'chat' ? t('modeChatIntro') : t('modeReceiptIntro')) : m.intro,
}));
---
<button
  type="button"
  class="cart-fab cart-trigger group fixed right-4 sm:right-6 bottom-[max(1rem,env(safe-area-inset-bottom))] z-[75] flex items-center gap-3 border-2 border-ink bg-lime text-ink px-4 sm:px-5 py-3 sm:py-3.5 font-bold shadow-[0_12px_32px_rgba(10,10,10,0.30)] hover:bg-ink hover:text-paper transition-[background-color,color,opacity] duration-200"
  aria-label={t('openCartAria')}
>
  <span class="relative inline-flex items-center justify-center">
    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true">
      <path d="M3 4h2.2l2.3 11.6a1.8 1.8 0 0 0 1.8 1.4h8.3a1.8 1.8 0 0 0 1.8-1.4L21 8H6.2" stroke="currentColor" stroke-width="2" stroke-linecap="square" stroke-linejoin="miter" />
      <circle cx="10" cy="20.2" r="1.5" fill="currentColor" />
      <circle cx="17.6" cy="20.2" r="1.5" fill="currentColor" />
    </svg>
    <span data-cart-count class="absolute -top-2.5 -right-2.5 min-w-[20px] h-5 px-1 grid place-items-center bg-ink text-lime font-mono text-[11px] leading-none group-hover:bg-lime group-hover:text-ink transition-colors">0</span>
  </span>
  <span class="flex flex-col items-start leading-none">
    <span class="font-mono text-[10px] tracking-[0.18em] opacity-70">{t('viewCart')}</span>
    <span data-cart-total class="font-mono text-sm mt-1 tabular-nums">USD 0</span>
  </span>
</button>

<div id="cart-backdrop" class="fixed inset-0 z-[80] bg-ink/50 transition-opacity opacity-0 pointer-events-none"></div>

<aside id="cart-drawer" class="fixed inset-y-0 right-0 z-[90] w-full sm:w-[420px] border-l-2 border-ink bg-paper flex flex-col transition-transform duration-300 translate-x-full pointer-events-none" aria-hidden="true" aria-label={t('cart')}>
  <header class="flex items-center justify-between gap-4 border-b-2 border-ink p-5">
    <div>
      <p class="font-mono text-xs text-muted">{t('cart')}</p>
      <p class="font-bold text-lg">{t('yourOrder')} <span data-cart-count class="font-mono">0</span></p>
    </div>
    <button id="cart-close" class="border-2 border-ink w-10 h-10 font-bold hover:bg-ink hover:text-paper transition-colors" aria-label={t('closeCartAria')}>✕</button>
  </header>

  <div class="flex-1 overflow-y-auto p-5 flex flex-col gap-6">
    <div id="cart-items" class="flex flex-col gap-4"></div>

    <div class="border-2 border-ink/20 p-5 flex flex-col gap-3">
      <div class="flex items-center justify-between text-sm">
        <span>{t('subtotal')}</span>
        <span id="cart-subtotal" class="font-mono">USD 0</span>
      </div>
      <div class="flex items-center justify-between text-sm">
        <span>{t('discount')}</span>
        <span id="cart-discount" class="font-mono text-green-700">-</span>
      </div>
      <div class="flex items-center justify-between font-bold text-lg border-t-2 border-ink/20 pt-3">
        <span>{t('total')}</span>
        <span id="cart-total" class="font-mono">USD 0</span>
      </div>
    </div>

    <div class="flex flex-col gap-4">
      <div>
        <label class="block font-mono text-xs text-muted mb-2">{t('instagramOptional')}</label>
        <input id="customer-ig" type="text" class="w-full border-2 border-ink px-3 py-2" placeholder={t('instagramPlaceholder')} />
      </div>
      <div>
        <label class="block font-mono text-xs text-muted mb-2">{t('notes')}</label>
        <textarea id="customer-notes" class="w-full border-2 border-ink px-3 py-2 min-h-[90px]" placeholder={t('notesPlaceholder')}></textarea>
      </div>
      <div>
        <span class="block font-mono text-xs text-muted mb-2">{t('whatsappMode')}</span>
        <div class="flex flex-col gap-2">
          {modes.map((m) => (
            <label class="flex items-start gap-2 text-sm">
              <input type="radio" class="mode-radio mt-1" name="mode" value={m.id} />
              <span>
                <strong>{m.label}</strong>
                <span class="block text-xs text-muted">{m.intro}</span>
              </span>
            </label>
          ))}
        </div>
      </div>
      <div id="receipt-hint" class="border-2 border-ink/20 px-4 py-3 hidden">
        <p class="font-bold text-sm">{t('receipt')}</p>
        <p class="text-xs text-muted mt-1">
          {t('receiptText')}
        </p>
      </div>
      <p class="text-xs text-muted">{t('audioNote')}</p>
    </div>
  </div>

  <footer class="flex flex-col gap-3 border-t-2 border-ink p-5 pb-[max(1.25rem,env(safe-area-inset-bottom))]">
    {SENA.enabled && (
      <div class="border-2 border-ink bg-ink text-paper overflow-hidden">
        <div class="bg-lime text-ink px-3 py-1.5 font-black text-xs tracking-[0.25em] uppercase text-center animate-pulse">
          {t('urgencyBanner')}
        </div>
    <button id="cart-sena" class="w-full px-5 py-3 font-bold text-center hover:bg-paper hover:text-ink transition-colors">
      {t('senaBtn')} {SENA.rate !== null ? `· ${SENA_PCT}%` : ''}
    </button>
      </div>
    )}
    <button id="cart-wa" class="border-2 border-ink px-5 py-3 font-bold text-center hover:bg-ink hover:text-paper transition-colors">{t('sendOrder')}</button>
    <button id="cart-clear" class="border-2 border-ink/30 px-4 py-2.5 font-mono text-xs hover:bg-ink hover:text-paper transition-colors">{t('clearCart')}</button>
  </footer>
</aside>