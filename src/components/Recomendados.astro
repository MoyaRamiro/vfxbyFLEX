---
const cards = [
  {
    preset: 'croma-full-4',
    title: 'Croma Full · 4 entornos',
    category: 'CROMA',
    tags: ['Croma', '3D'],
    note: 'Armado con los 4 entornos incluidos.',
    video: '/videos/croma 2.5D y 3D.webm',
  },
  {
    preset: 'vfx-full-all',
    title: 'VFX Full',
    category: 'VFX',
    tags: ['VFX'],
    note: 'Todos los componentes del paquete.',
    video: '/videos/vfx-full.webm',
  },
  {
    preset: 'visual-25d',
    title: 'Visual con imagen 2.5D',
    category: 'VISUAL',
    tags: ['Visual'],
    note: 'Una imagen en movimiento 2.5D.',
    video: '/videos/visuales.webm',
  },
];
---

<section class="px-6 md:px-10 py-20 md:py-28 border-t-2 border-ink/10 bg-paper">
  <div class="max-w-6xl mx-auto">
    <div class="flex flex-wrap items-end justify-between gap-4 mb-8">
      <div>
        <span class="font-mono text-xs tracking-widest text-muted">RECOMENDADOS</span>
        <h2 class="text-3xl md:text-5xl font-bold mt-2">Lo que más piden mis clientes</h2>
      </div>
    </div>
    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
      {cards.map((p) => (
        <button
          type="button"
          class="preset-card group flex flex-col border-2 border-ink bg-paper overflow-hidden hover:border-lime transition-colors text-left"
          data-preset={p.preset}
        >
          <div class="flex items-center justify-between border-b-2 border-ink px-3 py-2">
            <span class="font-mono text-xs font-bold tracking-widest">{p.category}</span>
            <span class="font-mono text-[10px] tracking-widest text-muted">PREVIEW</span>
          </div>
          <div class="relative aspect-video overflow-hidden bg-ink">
            <video
              src={encodeURI(p.video)}
              class="w-full h-full object-cover pointer-events-none group-hover:scale-[1.03] transition-transform duration-300"
              autoplay
              muted
              loop
              playsinline
              preload="metadata"
            ></video>
          </div>
          <div class="p-4 border-t-2 border-ink flex flex-col gap-2">
            <h3 class="text-lg font-bold">{p.title}</h3>
            <p class="text-xs text-muted">{p.note}</p>
            <div class="flex flex-wrap gap-2">
              {p.tags.map((t) => (
                <span class="border-2 border-ink/20 px-2 py-0.5 text-xs font-mono">{t}</span>
              ))}
            </div>
            <span class="mt-1 font-mono text-xs font-bold">Agregar al pedido →</span>
          </div>
        </button>
      ))}
    </div>
  </div>
</section>
