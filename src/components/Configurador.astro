---
import { CATEGORIES } from '../data/catalog';
import { DURATION, MOODS, PROMO, SENA } from '../config/order';
import { money, promoOriginal } from '../lib/pricing';
import visualizer from '../assets/projects/visualizer.png';
import croma from '../assets/projects/croma.png';
import vfxPro from '../assets/projects/vfx-pro.png';
import montaje from '../assets/projects/montaje.png';

const previews: Record<string, string> = {
  visual: visualizer.src,
  croma: croma.src,
  vfx: vfxPro.src,
  montaje: montaje.src,
};

// Piezas de video optimizadas en public/videos/preview (tiles) y /hd (modal).
const optionVideos: Record<string, string> = {
  'croma-25d-3d': 'croma-25d-3d',
  'croma-mezclado': 'croma-mezclado',
  'croma-video-full': 'croma-full',
  'croma-2d': 'croma-2d',
  'vfx-basico': 'vfx-basico',
  'vfx-pro': 'vfx-pro',
  'vfx-full': 'vfx-full',
  'montaje-montaje': 'montaje',
  'montaje-transiciones': 'transiciones',
  'visual-25d-imagen': 'visuales',
};

const videoPreview = (slug: string) => `/videos/preview/${slug}.mp4`;
const videoHd = (slug: string) => `/videos/hd/${slug}.mp4`;
const videoPoster = (slug: string) => `/videos/preview/${slug}.webp`;

// Estas opciones no llevan previsualización (ni video ni imagen).
const noPreview = new Set(['visual-only-lyrics', 'visual-lyrics-pro']);

// Ejemplos por componente de los paquetes VFX (según el sufijo del id).
const componentVideo = (id: string): string | undefined => {
  if (id.endsWith('-transiciones')) return 'transiciones';
  if (id.endsWith('-camaras')) return 'camaras-lentas';
  if (id.endsWith('-titulo')) return 'titulo';
  if (id.endsWith('-rotoscopia')) return 'rotoscopias';
  return undefined;
};
---

<section id="servicios" class="px-6 md:px-10 py-24 md:py-32 bg-surface">
  <div class="max-w-6xl mx-auto">
    <div class="flex items-end justify-between mb-4">
      <h2 class="servicios-title text-4xl md:text-6xl font-bold">Configurá tu pedido</h2>
      <span class="hidden md:block font-mono text-sm text-muted">TIMELINE · SERVICIOS</span>
    </div>
    <p class="text-muted mb-6 max-w-xl">
      Armá tu pedido paso a paso. El total se actualiza en vivo y al terminar lo mandás por WhatsApp.
    </p>

    <div id="promo-banner" class="promo-banner mb-8 relative overflow-hidden border-2 border-ink bg-ink" hidden>
      <div class="promo-stripes absolute inset-0" aria-hidden="true"></div>
      <div class="relative flex flex-wrap items-center justify-between gap-4 px-6 py-5">
        <div class="flex items-baseline gap-4">
          <span class="text-5xl md:text-7xl font-black tracking-tighter text-lime leading-none">30% OFF</span>
          <span class="text-xl md:text-3xl font-bold text-paper">SOLO POR HOY</span>
        </div>
        <div class="flex items-center gap-3">
          <span class="font-mono text-sm text-paper/70">Termina en</span>
          <span id="promo-countdown" class="font-mono text-2xl md:text-3xl font-black bg-lime text-ink px-4 py-1 tabular-nums">--:--:--</span>
        </div>
      </div>
    </div>

    <div class="grid lg:grid-cols-[minmax(0,1fr)_300px] gap-8 items-start">
      <div class="min-w-0">
        <div role="tablist" aria-label="Categorías" class="flex flex-wrap gap-2 mb-6">
          {CATEGORIES.map((c, i) => (
            <button
              type="button"
              role="tab"
              class="cat-tab border-2 border-ink px-4 py-2 font-bold hover:bg-ink hover:text-paper transition-colors"
              data-category={c.id}
              aria-selected={i === 0}
              aria-controls={`panel-${c.id}`}
            >
              {c.name}
            </button>
          ))}
        </div>

        {CATEGORIES.map((c, i) => (
          <div id={`panel-${c.id}`} class="cat-panel border-2 border-ink bg-paper p-6" data-panel={c.id} role="tabpanel" aria-label={c.name} hidden={i !== 0}>
            <header class="mb-5">
              <h3 class="text-2xl font-bold">{c.name}</h3>
              <p class="text-sm text-muted mt-1">{c.tagline}</p>
            </header>

            {c.groups.map((g) => (
              <fieldset class="group mb-6 last:mb-0" data-group={g.id} data-show-when={g.showWhen ?? ''} hidden={Boolean(g.showWhen)}>
                <legend class="font-mono text-xs tracking-widest text-muted mb-3">{g.name.toUpperCase()}</legend>
                <div class="flex flex-col gap-3" role={g.kind === 'single' ? 'radiogroup' : 'group'} aria-label={`${c.name} — ${g.name}`}>
                  {g.options.map((o) => (
                    <div class="option-item" data-option-item={o.id}>
                    <div class="option-row flex items-stretch gap-2" data-option-row={o.id}>
                      <button
                        type="button"
                        class="option-btn flex flex-1 items-center justify-between gap-3 border-2 border-ink/20 px-4 py-3 text-left hover:border-ink transition-colors"
                        data-category={c.id}
                        data-group={g.id}
                        data-option={o.id}
                        data-label={o.label}
                        data-price={o.price}
                        data-promo={o.promo ? '1' : '0'}
                        data-single={g.kind === 'single' ? '1' : '0'}
                        role={g.kind === 'single' ? 'radio' : undefined}
                        aria-checked={g.kind === 'single' ? 'false' : undefined}
                        aria-pressed={g.kind === 'single' ? undefined : 'false'}
                      >
                        <span class="flex flex-col">
                          <span class="font-bold">{o.label}</span>
                          {o.note && <span class="text-xs text-muted">{o.note}</span>}
                        </span>
                        <span class="option-price flex flex-col items-end shrink-0">
                          {o.promo && (
                            <s class="option-old text-xs text-muted" data-price={o.price}>
                              USD {money(promoOriginal(o.price))}
                            </s>
                          )}
                          <span class="option-now font-mono font-bold" data-price={o.price} data-promo={o.promo ? '1' : '0'}>USD {money(o.price)}</span>
                          {o.promo && (
                            <span class="option-badge bg-lime text-ink text-[10px] font-bold px-1.5 py-0.5 leading-none">-30%</span>
                          )}
                        </span>
                      </button>
                      {!noPreview.has(o.id) && (
                        <button
                          type="button"
                          class="preview-btn group relative shrink-0 w-28 sm:w-32 overflow-hidden border-2 border-ink/20 hover:border-ink transition-colors"
                          data-preview={optionVideos[o.id] ? videoHd(optionVideos[o.id]) : previews[c.id] ?? ''}
                          data-preview-type={optionVideos[o.id] ? 'video' : 'image'}
                          data-poster={optionVideos[o.id] ? videoPoster(optionVideos[o.id]) : undefined}
                          data-title={`${c.name} · ${o.label}`}
                          aria-label={`Previsualizar ${o.label}`}
                        >
                          {optionVideos[o.id] ? (
                            <video
                              data-src={videoPreview(optionVideos[o.id])}
                              poster={videoPoster(optionVideos[o.id])}
                              class="w-full h-16 sm:h-20 object-cover pointer-events-none"
                              muted
                              loop
                              playsinline
                              preload="none"
                            ></video>
                          ) : (
                            <img src={previews[c.id]} alt="" class="w-full h-16 sm:h-20 object-cover pointer-events-none" />
                          )}
                          <span class="absolute inset-0 grid place-items-center bg-ink/40 text-paper text-xs font-bold tracking-widest group-hover:bg-ink/60 transition-colors">Ver</span>
                        </button>
                      )}
                    </div>
                    {o.bundle && (
                      <div class="bundle-panel mt-2 border-2 border-ink/20 bg-surface p-3" data-bundle-panel={o.id} hidden>
                        <p class="font-mono text-[10px] tracking-widest text-muted mb-2">COMPONENTES INCLUIDOS · quitá los que no quieras</p>
                        <div class="flex flex-col gap-1.5">
                          {o.bundle.map((comp) => {
                            const vid = componentVideo(comp.id);
                            return (
                              <div class="flex items-center gap-2 text-sm">
                                <label class="flex items-center gap-2 cursor-pointer flex-1">
                                  <input type="checkbox" class="bundle-check accent-ink w-4 h-4" data-component={comp.id} checked />
                                  <span class="flex-1">{comp.label}</span>
                                  <span class="font-mono text-xs text-muted">USD {money(comp.price)}</span>
                                </label>
                                {vid && (
                                  <button
                                    type="button"
                                    class="preview-btn group relative shrink-0 w-20 h-12 overflow-hidden border-2 border-ink/20 hover:border-ink transition-colors"
                                    data-preview={videoHd(vid)}
                                    data-preview-type="video"
                                    data-poster={videoPoster(vid)}
                                    data-title={comp.label}
                                    aria-label={`Previsualizar ${comp.label}`}
                                  >
                                    <video
                                      data-src={videoPreview(vid)}
                                      poster={videoPoster(vid)}
                                      class="w-full h-full object-cover pointer-events-none"
                                      muted
                                      loop
                                      playsinline
                                      preload="none"
                                    ></video>
                                    <span class="absolute inset-0 grid place-items-center bg-ink/40 text-paper text-[10px] font-bold tracking-widest group-hover:bg-ink/60 transition-colors">Ver</span>
                                  </button>
                                )}
                              </div>
                            );
                          })}
                        </div>
                      </div>
                    )}
                    </div>
                  ))}
                </div>

                {c.entornos && (
                  <label class="mt-4 flex items-center gap-3 text-sm font-medium">
                    Cantidad de entornos
                    <select class="entornos-select border-2 border-ink px-3 py-2 bg-paper" data-default={c.entornos.defaultValue} aria-label="Cantidad de entornos">
                      {Array.from({ length: c.entornos.max - c.entornos.min + 1 }, (_, n) => c.entornos!.min + n).map((n) => (
                        <option value={n} selected={n === c.entornos!.defaultValue}>{n} {n === 1 ? 'entorno' : 'entornos'} (+USD {money(n * c.entornos!.priceEach)})</option>
                      ))}
                    </select>
                  </label>
                )}
              </fieldset>
            ))}
          </div>
        ))}
      </div>

      <aside class="flex flex-col gap-6 border-2 border-ink bg-paper p-6 lg:sticky lg:top-6">
        <div>
          <label for="duration-slider" class="font-mono text-xs tracking-widest text-muted">DURACIÓN</label>
          <div class="flex items-baseline justify-between mt-2 mb-3">
            <output id="duration-value" for="duration-slider" class="text-3xl font-bold font-mono">2:00</output>
          </div>
          <input id="duration-slider" type="range" class="duration-range w-full" min={DURATION.minSec} max={DURATION.maxSec} step={DURATION.stepSec} value={DURATION.defaultSec} />
          <div class="mt-3 flex flex-wrap items-center gap-2">
            <label for="duration-input" class="font-mono text-[10px] tracking-widest text-muted">ESCRIBIR</label>
            <input
              id="duration-input"
              type="text"
              inputmode="decimal"
              autocomplete="off"
              enterkeyhint="done"
              placeholder="3:30"
              aria-label="Escribir la duración en minutos y segundos"
              class="w-20 border-2 border-ink/20 px-2 py-1 font-mono text-sm outline-none focus:border-ink"
            />
            <span class="text-[11px] text-muted">min:seg o minutos (ej. 3 o 3:30)</span>
          </div>
          <p class="text-xs text-muted mt-2">Base 2:00. ±USD 10 por cada 30s, se suma a cada servicio. No aplica a Extras.</p>
        </div>

        <div>
          <span class="font-mono text-xs tracking-widest text-muted">MOOD</span>
          <div class="flex flex-col gap-2 mt-3" role="radiogroup" aria-label="Mood del video">
            {MOODS.map((m) => (
              <button type="button" class="mood-btn border-2 border-ink/20 px-3 py-2 text-left text-sm font-medium hover:border-ink transition-colors" data-mood={m.id} role="radio" aria-checked="false">
                {m.label}
              </button>
            ))}
          </div>
        </div>

        {SENA.enabled && (
          <div class="border-2 border-ink bg-lime/20 px-4 py-3">
            <p class="font-bold text-sm">Reserva con seña</p>
            <p class="text-xs text-muted mt-1">
              {SENA.rate === null
                ? 'El monto de la seña se confirma por WhatsApp.'
                : `Seña: ${Math.round(SENA.rate * 100)}% del total del pedido.`}
            </p>
          </div>
        )}
      </aside>
    </div>
  </div>

  <div id="preview-modal" class="fixed inset-0 z-[80] hidden" role="dialog" aria-modal="true" aria-labelledby="preview-title">
    <button type="button" id="preview-backdrop" class="absolute inset-0 bg-ink/70 cursor-default" aria-label="Cerrar previsualización" tabindex="-1"></button>
    <div class="relative mx-auto mt-[10vh] w-[min(92vw,720px)] border-2 border-ink bg-paper p-4">
      <div class="flex items-center justify-between gap-4 mb-3">
        <h4 id="preview-title" class="font-bold"></h4>
        <button type="button" id="preview-close" class="border-2 border-ink w-10 h-10 font-bold hover:bg-ink hover:text-paper transition-colors" aria-label="Cerrar">✕</button>
      </div>
      <div id="preview-body" class="aspect-video bg-surface border-2 border-ink/10 flex items-center justify-center overflow-hidden"></div>
    </div>
  </div>
</section>